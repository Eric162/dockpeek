#!/bin/sh
set -eu
cd "$(git rev-parse --show-toplevel)"
if ! git diff --quiet || ! git diff --cached --quiet || [ -n "$(git ls-files --others --exclude-standard)" ]; then
  echo "Commit or stash changes before pushing so checks match the outgoing code." >&2
  exit 1
fi
while read -r local_ref local_oid remote_ref remote_oid; do
  case "$local_oid" in 0000000000000000000000000000000000000000) continue ;; esac
  if [ "$local_oid" != "$(git rev-parse HEAD)" ]; then
    echo "Check out the branch being pushed before running its checks." >&2
    exit 1
  fi
  case "$remote_oid" in
    0000000000000000000000000000000000000000) range="$local_oid" ;;
    *) range="$remote_oid..$local_oid" ;;
  esac
  python3 scripts/check_commits.py --range "$range"
done
make check
